	"private": true,
	"license": "MIT",
	"author": {
		"name": "Scott Spence",
		"email": "cfromp@scottspence.dev",
		"url": "https://scottspence.com"
	},
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vp dev",
		"build": "vp build",
		"preview": "vp preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch --tsgo",
		"format": "vp check --fix",
		"lint": "vp check",
		"lint:fix": "vp check --fix",
		"test:unit": "vp test",
		"test:server": "vp test --project=server",
		"test:client": "vp test --project=client",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"coverage": "vp test --run --coverage"
	},
	"devDependencies": {
		"@fontsource-variable/hanken-grotesk": "^5.3.0",
		"@fontsource-variable/red-hat-mono": "^5.3.0",
		"@fontsource/gloock": "^5.3.0",
		"@lucide/svelte": "^1.48.0",
		"@playwright/test": "catalog:",
		"@sveltejs/adapter-cloudflare": "8.0.0-next.8",
		"@sveltejs/kit": "^3.0.0-next.30",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/sha1": "^1.1.5",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitest/browser-playwright": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"bits-ui": "^2.19.3",
		"clsx": "^2.1.1",
		"fathom-client": "^3.7.2",
		"mdsvex": "^0.12.8",
		"mode-watcher": "^1.1.0",
		"playwright": "catalog:",
		"sha1": "^1.1.1",
		"svead": "^0.0.16",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:",
		"vitest-browser-svelte": "^3.1.0"
	},
	"engines": {
		"node": ">=24.15.0"
	},
	"packageManager": "pnpm@12.8.1"
}
